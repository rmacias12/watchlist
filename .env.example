# Neon Postgres connection string (pooled)
# Vercel: Settings → Environment Variables → DATABASE_URL
# Local (`vercel dev`): put in .env.local as well
DATABASE_URL=postgresql…WORD@ep-xxxx-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Site unlock passcode (middleware.ts). Unset = site is publicly accessible.
# Generate one: openssl rand -hex 8
PASSCODE=change-me

# TMDB v3 API key (api/search.ts). Free at themoviedb.org -> Settings -> API.
# Unset = TMDB search in the add-item dialog is disabled (manual entry works).
TMDB_API_KEY=***
